# =========================
# SmartERP AI — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs réelles.
# Ne JAMAIS committer le fichier .env
# =========================

# --- Base de données PostgreSQL ---
POSTGRES_USER=smarterp
POSTGRES_PASSWORD=changeme
POSTGRES_DB=smarterp_ai
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://smarterp:changeme@db:5432/smarterp_ai

# --- Backend FastAPI ---
BACKEND_PORT=8000
SECRET_KEY=changeme-generate-a-random-secret
ENVIRONMENT=development

# --- Connexion Odoo (client) ---
ODOO_URL=https://client-instance.odoo.com
ODOO_DB=client_db
ODOO_USERNAME=api_user
ODOO_API_KEY=changeme

# --- Agent IA (Groq / LLaMA 3.3) ---
GROQ_API_KEY=changeme
GROQ_MODEL=llama-3.3-70b-versatile

# --- Frontend Next.js ---
NEXT_PUBLIC_API_URL=http://localhost:8000


# --- Toutes les 15 minutes : une tâche en arrière-plan (_sync_loop) relance automatiquement cette synchro ---
SYNC_INTERVAL_SECONDS=900

# --- Configuration SMTP (Envoi de rapports par email) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=votre.email@gmail.com
SMTP_PASSWORD=votre_mot_de_passe_d_application
SMTP_FROM=noreply@smarterp.ai